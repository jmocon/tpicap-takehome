# Copy to `.env` (`cp .env.example .env`) and edit. The npm scripts load it via
# Node's built-in `--env-file-if-exists=.env` — no dotenv dependency, and the
# scripts still run fine with no .env at all (the defaults in
# src/config/env.ts apply). Real environment variables always win over values
# in this file. Docker Compose doesn't use this file at all — it passes the
# same variables through its own `environment:` block.
PORT=4000
DATABASE_FILE=./data/trades.db
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string-in-production
